{
  "manifest_version": 3,
  "name": "ClearFare",
  "version": "0.1.0",
  "description": "항공권 표시가에 수수료·수하물·카드 수수료를 더한 최종 결제 예상 금액을 보여줍니다.",
  "permissions": ["storage"],
  "action": { "default_popup": "src/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.skyscanner.co.kr/*"],
      "js": ["src/fees.js", "src/content.js"],
      "css": ["src/badge.css"]
    }
  ]
}
